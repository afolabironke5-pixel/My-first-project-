
  <!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Nigerian Proverbs</title>
    <link rel="icon" href="favicon.ico" type="image/x-icon">
    <style>
      body {
        font-family: Arial, sans-serif;
        text-align: center;
        margin-top: 50px;
        background: url('background.jpg') no-repeat center center fixed;
        background-size: cover;
      }
      #proverb {
font-size: 1.5em;
        margin: 20px auto;
        color: #333;
        max-width: 600px;
        padding: 20px;
        background-color: rgba(255, 255, 255, 0.8);
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0,0,0,0.2);
      }
      button {
padding: 10px 20px;
        font-size: 1em;
        background-color: #008751;
        color: white;
        border: none;
        border-radius: 5px;
        cursor: pointer;
transition: all 0.3s ease;
      }
      button:hover {
        background-color: #006644;
        box-shadow: 0 0 10px #008751;
      }
    </style>
</head>
<body>
    <h1>Nigerian Proverbs 🌍</h1>
    <p id="proverb">Click the button to see a proverb.</p>
    <button onclick="showProverb()">Show Proverb</button>

    <script>
const proverbs = [
"A bird that flies off the earth and lands on an anthill is still on the ground.",
        "He who is destined for power does not have to fight for it.",
        "Even the best cooking pot will not produce food.",
        "A man who uses force is afraid of reasoning."
      ];
      function showProverb() {
        const randomIndex = Math.floor(Math.random() * proverbs.length);
        document.getElementById("proverb").innerText =
proverbs[randomIndex];
      }
    </script>
</body>
</html>
       