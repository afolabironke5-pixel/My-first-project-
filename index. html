`html
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>My First Website - Fun Facts</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      text-align: center;
      margin-top: 50px;
      background: linear-gradient(135deg, #f0f8ff, #e6ffe6);
    }
    #fact-box {
      max-width: 600px;
      margin: 20px auto;
      padding: 20px;
      background-color: rgba(255, 255, 255, 0.95);
      border-radius: 10px;
      box-shadow: 0 4px 8px rgba(0,0,0,0.2);
    }
    button {
      padding: 10px 20px;
      font-size: 1em;
      background-color: #008751;
      color: white;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      transition: all 0.3s ease;
    }
    button:hover {
      background-color: #006644;
      box-shadow: 0 0 10px #008751;
    }
    #fact {
      font-size: 1.3em;
      margin: 20px auto;
      color: #333;
    }
    #signature {
      margin-top: 40px;
      font-size: 1em;
      color: #555;
      font-style: italic;
      border-top: 1px solid #ccc;
      padding-top: 10px;
    }
  </style>
</head>
<body>
  <h1>🌍 Random Fun Facts</h1>

  <div id="fact-box">
    <p id="fact">Click the button to see a fun fact!</p>
    <button onclick="showFact()">Show Fact</button>
  </div>

  <!-- Your signature line -->
  <p id="signature">✨ Created by Aderonke 🌸</p>

  <script>
    const facts = [
      "Bananas are berries, but strawberries are not.",
      "Honey never spoils — archaeologists found edible honey in ancient tombs.",
      "Octopuses have three hearts.",
      "Sharks existed before trees.",
      "A day on Venus is longer than a year on Venus."
    ];

    function showFact() {
      const randomIndex = Math.floor(Math.random() * facts.length);
      document.getElementById("fact").innerText = facts[randomIndex];
    }
  </script>
</body>
</html>
`

